# Force strict peer-dependency resolution regardless of any contributor's
# global ~/.npmrc setting. A local `legacy-peer-deps=true` masked a real
# @types/node peer conflict (vite vs vitest) that only surfaced on Vercel's
# clean build environment — this pins the project to the strict behavior
# so that class of "works locally, fails in CI/deploy" bug is caught here
# instead.
legacy-peer-deps=false
