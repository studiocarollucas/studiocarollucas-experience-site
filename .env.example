# Supabase (SCL-004)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser (no NEXT_PUBLIC_ prefix).

# Database (SCL-005)
DATABASE_URL=

# Stable server-only secret, at least 32 random bytes, shared by every deployment
# instance. Required for inventory XLSX previews; rotation invalidates previews.
INVENTORY_IMPORT_TOKEN_SECRET=

# Set to "true" to run every live Supabase integration test, including Auth/RLS and
# private Storage lifecycle coverage (including contracts) under tests/domain/*integration.test.ts. Only
# enable this against a dev/staging project and audit fixture cleanup afterward —
# DATABASE_URL alone is intentionally not enough to arm these tests.
RUN_LIVE_DB_TESTS=

# App URL (SCL-006) — usado para montar o redirect absoluto do magic link.
# Produção: a URL publicada (ex.: https://studiocarollucas.com.br). Local: http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 (optional; public measurement identifier only)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console (optional; SCL-406) — only the token from the "HTML tag" method
# (the content of <meta name="google-site-verification">). Rendered on every page when set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Public WhatsApp CTA (full https://wa.me/<digits> URL) used by Minha Experiência and by
# every public site CTA (home, experiências, quiz, Paixão Clutch). The site falls back to the
# studio number when this is empty or not a wa.me URL; the visible number label follows it.
NEXT_PUBLIC_STUDIO_WHATSAPP_URL=

# schema.org structured data (SCL-406) — optional, published on the public site.
# Leave empty to omit. Never reuse STUDIO_CONTRACTOR_ADDRESS here.
STUDIO_PUBLIC_STREET_ADDRESS=
STUDIO_PUBLIC_ADDRESS_LOCALITY=
STUDIO_PUBLIC_ADDRESS_REGION=
STUDIO_PUBLIC_POSTAL_CODE=
# Comma-separated public profile URLs (https only), e.g. Instagram.
STUDIO_PUBLIC_SAME_AS=

# Contratos PDF (SCL-310) — valores protegidos apenas no servidor.
STUDIO_CONTRACTOR_NAME=
STUDIO_CONTRACTOR_CPF=
STUDIO_CONTRACTOR_ADDRESS=

# Observability (SCL-008)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Usadas por next.config.ts (withSentryConfig) no upload de source maps durante o build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# E-mail transacional (SCL-700/SCL-705) — ver docs/runbooks/email-automation.md.
# Só envia e-mail real com EMAIL_DELIVERY_ENABLED=true (literal). Qualquer outro valor
# usa o provider de log (nada sai do servidor). Deixe desligado em dev, test e Preview;
# em produção (VERCEL_ENV=production) desligado faz o cron responder 503.
EMAIL_DELIVERY_ENABLED=
# Chave da API do Resend (server-only; nunca com prefixo NEXT_PUBLIC_).
RESEND_API_KEY=
# Remetente em domínio verificado no Resend, ex.: Stúdio Carol Lucas <ola@studiocarollucas.com.br>
EMAIL_FROM=
# Opcional: endereço que recebe as respostas das clientes.
EMAIL_REPLY_TO=
# Segredo do endpoint /api/cron/email-deliveries (Authorization: Bearer ...).
# Mínimo de 32 caracteres; gere com `openssl rand -hex 32`. Sem ele o endpoint responde 503.
CRON_SECRET=

# Storage (future — Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
