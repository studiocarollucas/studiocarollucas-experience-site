# Supabase (SCL-004)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser (no NEXT_PUBLIC_ prefix).

# Database (SCL-005)
DATABASE_URL=

# Set to "true" to run every live Supabase integration test, including Auth/RLS and
# private Storage lifecycle coverage (including contracts) under tests/domain/*integration.test.ts. Only
# enable this against a dev/staging project and audit fixture cleanup afterward —
# DATABASE_URL alone is intentionally not enough to arm these tests.
RUN_LIVE_DB_TESTS=

# App URL (SCL-006) — usado para montar o redirect absoluto do magic link.
# Produção: a URL publicada (ex.: https://studiocarollucas.com.br). Local: http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Public WhatsApp CTA used by Minha Experiência (full https://wa.me/... URL).
NEXT_PUBLIC_STUDIO_WHATSAPP_URL=

# Contratos PDF (SCL-310) — valores protegidos apenas no servidor.
STUDIO_CONTRACTOR_NAME=
STUDIO_CONTRACTOR_CPF=
STUDIO_CONTRACTOR_ADDRESS=

# Observability (SCL-008)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Usadas por next.config.ts (withSentryConfig) no upload de source maps durante o build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Email (future — Resend)
RESEND_API_KEY=

# Storage (future — Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
