# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SDD tooling scratch space (task briefs, reports, progress ledger) — not part of the app
.superpowers/

# Local linked worktrees created for isolated feature execution.
.worktrees/

# Claude Code harness scratch state — only lock files and per-developer local overrides,
# so shared settings/hooks/skills under .claude/ stay committable.
.claude/*.lock
.claude/settings.local.json

# Acervo original local; publicar somente a curadoria otimizada em images/site.
/public/images/15-anos/
/public/images/aniversario-adulto/
/public/images/gestante/
/public/images/newborn/
